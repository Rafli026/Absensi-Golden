# Salin file ini menjadi .env di server, lalu sesuaikan nilainya.
#   cp .env.production.example .env
#   chmod 600 .env
#
# Generate JWT_SECRET (minimal 32 karakter acak):
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

NODE_ENV=production
PORT=3000

# Path relatif terhadap root proyek (atau absolute path).
DB_PATH=./data/absensi.db

# WAJIB diganti. Jangan pernah commit nilai asli ke git.
JWT_SECRET=<ganti dengan string acak minimal 32 karakter>

SESSION_TTL_HOURS=12
APP_TIMEZONE=Asia/Jakarta

# true jika diakses via HTTPS (produksi). Cookie tidak akan dikirim lewat HTTP.
COOKIE_SECURE=true

LOCATION_VALIDATION_ENABLED=true
FACE_MATCH_THRESHOLD=0.5
ATTENDANCE_COOLDOWN_SECONDS=60

LATE_DEDUCTION_MODE=per_occurrence
LATE_DEDUCTION_PER_OCCURRENCE=0
LATE_DEDUCTION_PER_BLOCK=0
LATE_DEDUCTION_BLOCK_MINUTES=10
