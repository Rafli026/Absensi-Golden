# --- Server ---------------------------------------------------------------
# Port HTTP yang didengarkan (di belakang reverse proxy biasanya 3000).
PORT=3000

# Lokasi file SQLite (relatif ke root proyek atau absolut).
DB_PATH=./data/absensi.db

# --- Keamanan (WAJIB) -----------------------------------------------------
# Kunci HMAC untuk token sesi. WAJIB minimal 32 karakter.
# Buat dengan: openssl rand -hex 32
JWT_SECRET=change-me-in-production

# Masa berlaku cookie sesi dalam jam.
SESSION_TTL_HOURS=12

# development | production
# production: cookie Secure otomatis aktif, HSTS dikirim, demo_mode=false.
NODE_ENV=production

# Paksa status Secure pada cookie auth.
# Default: true bila NODE_ENV=production, false bila development.
# Set false HANYA untuk kasus khusus (mis. produksi di balik proxy HTTP internal).
COOKIE_SECURE=true

# Jumlah hop reverse proxy yang dipercaya untuk X-Forwarded-* (Caddy/Nginx = 1).
TRUST_PROXY=1

# --- Aplikasi -------------------------------------------------------------
APP_TIMEZONE=Asia/Jakarta

# Nilai awal saat seed (setelah itu diatur dari halaman Settings).
LOCATION_VALIDATION_ENABLED=true
FACE_MATCH_THRESHOLD=0.5
ATTENDANCE_COOLDOWN_SECONDS=60
LATE_DEDUCTION_MODE=per_occurrence
LATE_DEDUCTION_PER_OCCURRENCE=0
LATE_DEDUCTION_PER_BLOCK=0
LATE_DEDUCTION_BLOCK_MINUTES=10
